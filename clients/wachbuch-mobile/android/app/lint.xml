<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
      Wachbuch only calls getLastKnownPosition/getCurrentPosition with normal
      LocationSettings and never enables Geolocator foreground/background mode.
      The dependency still packages BackgroundNotification, so lint sees its
      optional notify() path and asks for POST_NOTIFICATIONS. Suppress only that
      dependency class instead of expanding the app's runtime permissions.
    -->
    <issue id="NotificationPermission">
        <ignore regexp="com\.baseflow\.geolocator\.location\.BackgroundNotification" />
    </issue>

    <!--
      Flutter Stable generated AGP 9.0.1 with Gradle 9.1.0. Android's official
      compatibility table lists Gradle 9.1.0 as the minimum for AGP 9.0. Keep
      that tested Flutter toolchain pair instead of independently advancing the
      wrapper. Limit the exception to this one wrapper file; dependency update
      automation continues to surface future Flutter/AGP changes.
    -->
    <issue id="AndroidGradlePluginVersion">
        <ignore regexp="gradle-wrapper\.properties" />
    </issue>

    <!--
      AGP 9.3.x BidirectionalTextDetector can crash under JDK 17 with
      NoSuchMethodError on List.removeLast() while analyzing plugin sources
      (connectivity_plus, geolocator_android). CI runs lint on JDK 21; keep
      this ignore as a belt-and-suspenders guard if a runner regresses to 17.
    -->
    <issue id="BidiSpoofing" severity="ignore" />
</lint>
