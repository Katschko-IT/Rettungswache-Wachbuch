#!/bin/sh
# wachbuch – Verwaltung einer mit install.sh eingerichteten Installation.
# Liegt im Installationsordner neben compose.yml und .env.
#
#   wachbuch status | logs [dienst] | backup | restore DATEI | update [VERSION]
#   wachbuch auto-update an|aus|status | setup-code | start | stop | uninstall [--purge] | help
set -eu

REPO_SLUG="Katschko-IT/Rettungswache-Wachbuch"
DEFAULT_BASE_URL="https://raw.githubusercontent.com/${REPO_SLUG}"

say() { printf '==> %s\n' "$*"; }
warn() { printf 'Warnung: %s\n' "$*" >&2; }
die() { printf 'Fehler: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<'EOF'
wachbuch – Verwaltung des Rettungswache-Wachbuchs

  status              Dienste, Gesundheit und Version anzeigen
  logs [DIENST...]    Logs anzeigen (z. B. web, notify-worker, backup)
  backup              sofort ein Backup erstellen und nach ./backups kopieren
  restore DATEI       Datenbank aus einem Backup wiederherstellen (mit Rückfrage)
                      DATEI: Pfad auf diesem Rechner oder Name aus dem Backup-Volume
  update [VERSION]    Backup, neue Version laden, neu starten
  auto-update an [sicherheit|alle] [--zeit HH:MM]
                      nächtliche Updates einschalten (Standard: sicherheit, 03:30)
                        sicherheit: gleiche Version, neu gebaute Images
                                    (Sicherheitsupdates von Debian/Alpine)
                        alle:       zusätzlich neue Versionen derselben
                                    Hauptversion
                      Vorher Backup, bei gescheitertem Start Rollback.
  auto-update aus     nächtliche Updates ausschalten
  auto-update status  Einstellung, Zeitplan und letzte Läufe anzeigen
  setup-code          Einrichtungscode für die Ersteinrichtung anzeigen
  start | stop        Wachbuch starten bzw. anhalten
  uninstall [--purge] Container entfernen; --purge löscht auch alle Daten
  help                diese Hilfe

Optionen: -y/--yes beantwortet Rückfragen mit Ja (für Skripte).
EOF
}

# Installationsordner: dort, wo dieses Skript liegt (auch über einen Symlink).
self="$0"
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname "$self")/$link" ;;
    esac
done
WACHBUCH_DIR="${WACHBUCH_DIR:-$(cd "$(dirname "$self")" && pwd)}"
cd "$WACHBUCH_DIR"
if [ ! -f .env ] || [ ! -f compose.yml ]; then
    die "$WACHBUCH_DIR ist kein Wachbuch-Ordner (compose.yml/.env fehlen)."
fi

# Compose liest COMPOSE_FILE, COMPOSE_PROJECT_NAME und COMPOSE_PROFILES aus .env.
dc() { docker compose "$@"; }

env_get() {
    value=$(sed -n "s/^$1=//p" .env | tail -n 1)
    case "$value" in
        \'*\') value=${value#\'}; value=${value%\'} ;;
        \"*\") value=${value#\"}; value=${value%\"} ;;
    esac
    printf '%s' "$value"
}

env_set() {
    if grep -q "^$1=" .env; then
        K="$1" V="$2" awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"] }
            index($0, k "=") == 1 { print k "=" v; next } { print }' .env >.env.tmp.$$
        cat .env.tmp.$$ >.env
        rm -f .env.tmp.$$
    else
        printf '%s=%s\n' "$1" "$2" >>.env
    fi
}

ASSUME_YES=0
confirm() {  # confirm "Frage" "Wort" -> 0 wenn bestätigt
    [ "$ASSUME_YES" -eq 0 ] || return 0
    { [ -r /dev/tty ] && (: </dev/tty) 2>/dev/null; } \
        || die "Rückfrage nicht möglich (kein Terminal); mit --yes bestätigen."
    printf '%s\nZum Bestätigen "%s" eingeben: ' "$1" "$2" >/dev/tty
    answer=""
    IFS= read -r answer </dev/tty || true
    [ "$answer" = "$2" ]
}

http_get() {
    if have curl; then
        curl -fsS --max-time 5 "$1"
    elif have wget; then
        wget -q -T 5 -O - "$1"
    else
        return 2
    fi
}

running() { [ -n "$(dc ps -q --status running "$1" 2>/dev/null)" ]; }

build_mode() {
    case "$(env_get COMPOSE_FILE)" in *compose.build.yml*) return 0 ;; esac
    return 1
}

cmd_status() {
    dc ps --format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}'
    port=$(env_get HTTP_PORT)
    url="http://127.0.0.1:${port:-8090}/healthz/"
    printf '\n'
    if result=$(http_get "$url" 2>/dev/null); then
        say "Healthcheck OK: $result"
    else
        warn "Healthcheck $url antwortet nicht."
        return 1
    fi
    origin=$(env_get SITE_URL)
    [ -z "$origin" ] || say "Adresse: $origin/"
}

cmd_logs() {
    if [ -t 1 ]; then
        dc logs --tail 200 -f "$@"
    else
        dc logs --tail 200 --no-color "$@"
    fi
}

# Erstellt einen Dump im Backup-Volume und kopiert ihn nach ./backups.
cmd_backup() {
    if running backup; then
        output=$(dc exec -T backup /bin/sh /usr/local/bin/rwsth-backup-loop once) || {
            printf '%s\n' "$output"
            die "Backup fehlgeschlagen."
        }
    else
        running db || die "Die Datenbank läuft nicht (wachbuch start)."
        output=$(dc run --rm --no-deps -T backup once) || {
            printf '%s\n' "$output"
            die "Backup fehlgeschlagen."
        }
    fi
    printf '%s\n' "$output" | grep -v '^BACKUP_FILE=' || true
    file=$(printf '%s\n' "$output" | sed -n 's/^BACKUP_FILE=//p' | tail -n 1)
    [ -n "$file" ] || die "Backup-Datei unbekannt."
    mkdir -p backups
    chmod 700 backups
    if running backup; then
        dc cp "backup:$file" "backups/" >/dev/null
    else
        dc run --rm --no-deps -T --entrypoint cat backup "$file" >"backups/$(basename "$file")"
    fi
    chmod 600 "backups/$(basename "$file")"
    say "Backup: $WACHBUCH_DIR/backups/$(basename "$file")"
    say "Zusammen mit .env an einem zweiten Ort aufbewahren."
}

cmd_restore() {
    [ $# -ge 1 ] || die "Aufruf: wachbuch restore DATEI"
    source_file="$1"
    db_name=$(env_get POSTGRES_DB)
    if [ -f "$source_file" ]; then
        mode=host
        label="$source_file"
    else
        case "$source_file" in
            */*|*..*) die "$source_file nicht gefunden." ;;
        esac
        dc run --rm --no-deps -T --entrypoint test restore-test -f "/backups/$source_file" \
            || die "$source_file weder auf diesem Rechner noch im Backup-Volume gefunden."
        mode=volume
        label="Backup-Volume: $source_file"
    fi
    confirm "Die Datenbank '$db_name' wird vollständig durch den Stand aus $label ersetzt.
Alle Änderungen seit diesem Backup gehen verloren." "WIEDERHERSTELLEN" \
        || die "Abgebrochen."

    say "Sicherheits-Backup des aktuellen Stands"
    cmd_backup
    say "Anwendung anhalten"
    dc stop web feed-worker notify-worker push-worker
    say "Wiederherstellen"
    # Wird im Container ausgewertet (PGDATABASE dort gesetzt).
    # shellcheck disable=SC2016
    restore_cmd='pg_restore --clean --if-exists --no-owner --no-acl --single-transaction --exit-on-error --dbname "$PGDATABASE" "$@"'
    if [ "$mode" = host ]; then
        dc run --rm --no-deps -T --entrypoint /bin/sh restore-test -c "$restore_cmd" restore <"$source_file" \
            || die "Wiederherstellung fehlgeschlagen; die Datenbank ist unverändert (eine Transaktion). Starten: wachbuch start"
    else
        dc run --rm --no-deps -T --entrypoint /bin/sh restore-test -c "$restore_cmd" restore "/backups/$source_file" \
            || die "Wiederherstellung fehlgeschlagen; die Datenbank ist unverändert (eine Transaktion). Starten: wachbuch start"
    fi
    say "Migrationen und Datenbankrechte"
    dc run --rm --no-deps -T migrate
    say "Starten"
    dc up -d --wait --wait-timeout 600
    say "Wiederherstellung abgeschlossen."
}

download() {
    tmp="$2.download.$$"
    if have curl; then
        curl -fsSL --retry 3 --connect-timeout 15 -o "$tmp" "$1" || { rm -f "$tmp"; return 1; }
    elif have wget; then
        wget -q -O "$tmp" "$1" || { rm -f "$tmp"; return 1; }
    else
        die "Weder curl noch wget gefunden."
    fi
}

latest_version() {
    have curl || return 0
    api=$(env_get WACHBUCH_RELEASES_API)
    api="${api:-https://api.github.com/repos/${REPO_SLUG}/releases/latest}"
    curl -fsSL --max-time 15 "$api" 2>/dev/null \
        | sed -n 's/.*"tag_name": *"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | head -n 1 || true
}

# Neue compose.yml/Caddyfile/wachbuch holen. Neue Dateien werden erst nach
# erfolgreichem Download per mv übernommen (das laufende Skript bleibt heil).
refresh_files() {
    ref="$1"
    source_dir=$(env_get WACHBUCH_SOURCE)
    base=$(env_get WACHBUCH_BASE_URL)
    base="${base:-$DEFAULT_BASE_URL}"
    set -- docker-compose.yml:compose.yml deploy/caddy/Caddyfile:deploy/caddy/Caddyfile scripts/wachbuch:wachbuch
    if build_mode; then
        set -- "$@" compose.build.yml:compose.build.yml
    fi
    for pair in "$@"; do
        from=${pair%%:*}
        to=${pair#*:}
        mkdir -p "$(dirname "$to")"
        if [ -n "$source_dir" ]; then
            cp "$source_dir/$from" "$to.download.$$" || die "$source_dir/$from fehlt."
        else
            download "$base/$ref/$from" "$to" || die "Download fehlgeschlagen: $base/$ref/$from"
        fi
    done
    for pair in "$@"; do
        to=${pair#*:}
        mv "$to.download.$$" "$to"
    done
    chmod 755 wachbuch
}

cmd_update() {
    target="${1:-}"
    target=$(printf '%s' "$target" | sed 's/^v//')
    if [ -z "$target" ] && ! build_mode && [ -z "$(env_get WACHBUCH_SOURCE)" ]; then
        target=$(latest_version)
    fi
    target="${target:-$(env_get WACHBUCH_VERSION)}"
    target="${target:-latest}"
    case "$target" in
        latest) ref=main ;;
        *[!0-9.]*) die "Ungültige Version: $target" ;;
        *) ref="v$target" ;;
    esac

    if running db; then
        say "Backup vor dem Update"
        cmd_backup
    else
        warn "Datenbank läuft nicht – Update ohne vorheriges Backup."
    fi
    say "Dateien aktualisieren ($target)"
    refresh_files "$ref"
    env_set WACHBUCH_VERSION "$target"
    if build_mode; then
        say "Images neu bauen"
        dc build --pull
    else
        say "Images laden"
        dc pull --quiet --ignore-buildable
    fi
    say "Neu starten"
    dc up -d --remove-orphans --wait --wait-timeout 600
    cmd_status
}

# --- Automatische Updates ----------------------------------------------------

AUTO_LOG="logs/auto-update.log"
AUTO_LOCK="logs/auto-update.lock"

auto_log() {
    mkdir -p logs
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$AUTO_LOG"
    printf '%s\n' "$*"
}

# 0, wenn Version $1 neuer ist als $2 (nur Ziffern und Punkte).
version_gt() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        split(a, x, "."); split(b, y, ".")
        for (i = 1; i <= 3; i++) {
            if (x[i] + 0 > y[i] + 0) exit 0
            if (x[i] + 0 < y[i] + 0) exit 1
        }
        exit 1
    }'
}

# Zeilen „IMAGE ID“ für alle Images der Installation.
snapshot_images() {
    dc config --images 2>/dev/null | sort -u | while IFS= read -r image; do
        [ -n "$image" ] || continue
        printf '%s %s\n' "$image" "$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null || true)"
    done
}

# Container, die nicht mit dem aktuellen Stand ihres Image-Tags laufen
# (z. B. nach einem manuellen Pull ohne Neustart).
stale_containers() {
    dc ps -q 2>/dev/null | while IFS= read -r container; do
        [ -n "$container" ] || continue
        image=$(docker inspect --format '{{.Config.Image}}' "$container" 2>/dev/null) || continue
        running_id=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null) || continue
        tag_id=$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null) || continue
        [ "$running_id" = "$tag_id" ] || printf '%s\n' "$image"
    done
}

# Sicherungs-Tags für den Rollback. Über die Image-ID lässt sich ein Image
# nach dem Pull nicht zuverlässig zurückholen: Im containerd-Image-Speicher
# (Docker 29) ist ein Image ohne Namen per ID nicht mehr erreichbar.
ROLLBACK_SUFFIX="-wb-rollback"

own_tagged_images() {  # Namen mit Tag, ohne per Digest gepinnte Fremd-Images
    printf '%s\n' "$1" | while read -r image id; do
        [ -n "$id" ] || continue
        case "$image" in *@*) continue ;; esac
        printf '%s\n' "$image"
    done
}

keep_rollback_images() {
    own_tagged_images "$1" | while IFS= read -r image; do
        docker tag "$image" "$image$ROLLBACK_SUFFIX" >/dev/null 2>&1 || true
    done
}

restore_images() {
    own_tagged_images "$1" | while IFS= read -r image; do
        docker tag "$image$ROLLBACK_SUFFIX" "$image" >/dev/null 2>&1 || true
    done
}

drop_rollback_images() {
    own_tagged_images "$1" | while IFS= read -r image; do
        docker image rm "$image$ROLLBACK_SUFFIX" >/dev/null 2>&1 || true
    done
}

ROLLBACK_FILES="compose.yml deploy/caddy/Caddyfile wachbuch"

save_rollback_files() {
    rm -rf logs/rollback
    for file in $ROLLBACK_FILES; do
        [ -f "$file" ] || continue
        mkdir -p "logs/rollback/$(dirname "$file")"
        cp -p "$file" "logs/rollback/$file"
    done
}

restore_rollback_files() {
    for file in $ROLLBACK_FILES; do
        [ -f "logs/rollback/$file" ] && cp -p "logs/rollback/$file" "$file"
    done
    rm -rf logs/rollback
}

cmd_auto_update_run() {
    mode=$(env_get WACHBUCH_AUTO_UPDATE)
    case "$mode" in
        sicherheit|alle) ;;
        *) return 0 ;;
    esac
    if build_mode || [ -n "$(env_get WACHBUCH_SOURCE)" ]; then
        auto_log "Übersprungen: Entwicklungsinstallation (lokal gebaut oder aus einem Checkout)."
        return 0
    fi
    mkdir -p logs
    # Eine hängengebliebene Sperre (Absturz, Stromausfall) gilt nach 6 h als frei.
    find logs -maxdepth 1 -name auto-update.lock -mmin +360 -exec rmdir {} \; 2>/dev/null || true
    if ! mkdir "$AUTO_LOCK" 2>/dev/null; then
        auto_log "Übersprungen: ein Update läuft bereits."
        return 0
    fi
    trap 'rmdir "$AUTO_LOCK" 2>/dev/null || true' EXIT INT TERM

    current=$(env_get WACHBUCH_VERSION)
    case "$current" in
        ''|*[!0-9.]*)
            auto_log "Übersprungen: keine feste Version eingestellt (WACHBUCH_VERSION=${current:-leer})."
            return 0
            ;;
    esac
    target="$current"
    if [ "$mode" = alle ]; then
        latest=$(latest_version)
        if [ -n "$latest" ] && version_gt "$latest" "$current"; then
            if [ "${latest%%.*}" = "${current%%.*}" ]; then
                target="$latest"
            else
                auto_log "Neue Hauptversion $latest verfügbar – bitte bewusst mit 'wachbuch update $latest' einspielen."
            fi
        fi
    fi

    before=$(snapshot_images)
    new_version=0
    if [ "$target" != "$current" ]; then
        auto_log "Neue Version $target (bisher $current)."
        save_rollback_files
        if ! (refresh_files "v$target") >>"$AUTO_LOG" 2>&1; then
            restore_rollback_files
            auto_log "Dateien für $target konnten nicht geladen werden; nichts geändert."
            return 1
        fi
        env_set WACHBUCH_VERSION "$target"
        new_version=1
    fi

    keep_rollback_images "$before"
    if ! dc pull --quiet --ignore-buildable >>"$AUTO_LOG" 2>&1; then
        restore_images "$before"
        if [ "$new_version" -eq 1 ]; then
            restore_rollback_files
            env_set WACHBUCH_VERSION "$current"
        fi
        auto_log "Images konnten nicht geladen werden; nichts geändert."
        return 1
    fi
    after=$(snapshot_images)
    if [ "$new_version" -eq 0 ] && [ "$before" = "$after" ] && [ -z "$(stale_containers)" ]; then
        drop_rollback_images "$before"
        auto_log "Alles aktuell (Version $current)."
        return 0
    fi

    auto_log "Backup vor dem Update"
    if ! (cmd_backup) >>"$AUTO_LOG" 2>&1; then
        restore_images "$before"
        if [ "$new_version" -eq 1 ]; then
            restore_rollback_files
            env_set WACHBUCH_VERSION "$current"
        fi
        auto_log "Backup fehlgeschlagen – Update abgebrochen, laufender Stand unverändert."
        return 1
    fi

    auto_log "Neustart mit Version $target"
    if dc up -d --remove-orphans --wait --wait-timeout 600 >>"$AUTO_LOG" 2>&1; then
        auto_log "Update erfolgreich (Version $target)."
        rm -rf logs/rollback
        drop_rollback_images "$before"
        docker image prune -f >/dev/null 2>&1 || true
        return 0
    fi

    auto_log "Start fehlgeschlagen – Rollback auf den vorherigen Stand."
    restore_images "$before"
    if [ "$new_version" -eq 1 ]; then
        restore_rollback_files
        env_set WACHBUCH_VERSION "$current"
    fi
    if dc up -d --remove-orphans --wait --wait-timeout 600 >>"$AUTO_LOG" 2>&1; then
        drop_rollback_images "$before"
        auto_log "Rollback erfolgreich; es läuft wieder Version $current."
    else
        auto_log "Rollback-Start fehlgeschlagen – bitte 'wachbuch status' prüfen; das Backup liegt unter backups/, die vorherigen Images unter *$ROLLBACK_SUFFIX."
    fi
    return 1
}

auto_unit_name() {
    printf 'wachbuch-auto-update-%s' "$(printf '%s' "$WACHBUCH_DIR" | cksum | cut -d' ' -f1)"
}

uses_systemd() {
    [ "$(id -u)" -eq 0 ] && have systemctl && [ -d /run/systemd/system ]
}

cron_marker() { printf '# wachbuch-auto-update %s' "$WACHBUCH_DIR"; }

cron_without_entry() {
    crontab -l 2>/dev/null | grep -vF "$(cron_marker)" || true
}

schedule_install() {
    hour="$1"
    minute="$2"
    if uses_systemd; then
        unit=$(auto_unit_name)
        cat >"/etc/systemd/system/$unit.service" <<EOF
[Unit]
Description=Wachbuch: automatisches Update ($WACHBUCH_DIR)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$WACHBUCH_DIR/wachbuch auto-update run
EOF
        cat >"/etc/systemd/system/$unit.timer" <<EOF
[Unit]
Description=Wachbuch: nächtliches Update ($WACHBUCH_DIR)

[Timer]
OnCalendar=*-*-* $(printf '%02d:%02d' "$hour" "$minute"):00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
EOF
        systemctl daemon-reload
        systemctl enable --now "$unit.timer" >/dev/null
        SCHEDULER="systemd-Timer $unit.timer"
    else
        have crontab || die "Weder systemd (als root) noch crontab verfügbar."
        line="$minute $hour * * * PATH='$PATH' '$WACHBUCH_DIR/wachbuch' auto-update run >/dev/null 2>&1 $(cron_marker)"
        { cron_without_entry; printf '%s\n' "$line"; } | sed '/^$/d' | crontab -
        SCHEDULER="crontab"
    fi
}

schedule_remove() {
    if uses_systemd; then
        unit=$(auto_unit_name)
        if [ -f "/etc/systemd/system/$unit.timer" ]; then
            systemctl disable --now "$unit.timer" >/dev/null 2>&1 || true
            rm -f "/etc/systemd/system/$unit.timer" "/etc/systemd/system/$unit.service"
            systemctl daemon-reload
        fi
    fi
    if have crontab && crontab -l 2>/dev/null | grep -qF "$(cron_marker)"; then
        cron_without_entry | crontab -
    fi
}

auto_on() {
    mode=sicherheit
    time=03:30
    while [ $# -gt 0 ]; do
        case "$1" in
            sicherheit|alle) mode="$1" ;;
            --zeit|--time)
                [ $# -ge 2 ] || die "--zeit braucht eine Uhrzeit (HH:MM)."
                time="$2"
                shift
                ;;
            *) die "Unbekannte Angabe: $1 (erlaubt: sicherheit, alle, --zeit HH:MM)" ;;
        esac
        shift
    done
    case "$time" in
        [0-2][0-9]:[0-5][0-9]) ;;
        *) die "Ungültige Uhrzeit: $time (Format HH:MM)" ;;
    esac
    # Führende Null entfernen, sonst lesen cron/printf „08“ als Oktalzahl.
    hour=${time%%:*}
    hour=${hour#0}
    minute=${time#*:}
    minute=${minute#0}
    [ "$hour" -le 23 ] || die "Ungültige Uhrzeit: $time"
    if build_mode || [ -n "$(env_get WACHBUCH_SOURCE)" ]; then
        die "Automatische Updates gibt es nur für Installationen mit veröffentlichten Images."
    fi
    schedule_install "$hour" "$minute"
    env_set WACHBUCH_AUTO_UPDATE "$mode"
    env_set WACHBUCH_AUTO_UPDATE_TIME "$time"
    say "Automatische Updates eingeschaltet: $mode, täglich um $time ($SCHEDULER)."
    say "Protokoll: $WACHBUCH_DIR/$AUTO_LOG"
}

auto_off() {
    schedule_remove
    env_set WACHBUCH_AUTO_UPDATE aus
    say "Automatische Updates ausgeschaltet."
}

auto_status() {
    mode=$(env_get WACHBUCH_AUTO_UPDATE)
    case "$mode" in
        sicherheit|alle) say "Automatische Updates: $mode, täglich um $(env_get WACHBUCH_AUTO_UPDATE_TIME)" ;;
        *) say "Automatische Updates: aus" ;;
    esac
    say "Installierte Version: $(env_get WACHBUCH_VERSION)"
    if [ -f "$AUTO_LOG" ]; then
        say "Letzte Einträge ($AUTO_LOG):"
        tail -n 8 "$AUTO_LOG"
    fi
}

cmd_auto_update() {
    sub="${1:-status}"
    [ $# -eq 0 ] || shift
    case "$sub" in
        an|on) auto_on "$@" ;;
        aus|off) auto_off ;;
        status) auto_status ;;
        run) cmd_auto_update_run ;;
        *) die "Aufruf: wachbuch auto-update an [sicherheit|alle] [--zeit HH:MM] | aus | status" ;;
    esac
}

cmd_setup_code() {
    code=$(env_get SETUP_BOOTSTRAP_TOKEN)
    origin=$(env_get SITE_URL)
    if [ -z "$code" ]; then
        say "Kein Einrichtungscode gesetzt (Ersteinrichtung abgeschlossen oder Code entfernt)."
        return 0
    fi
    say "Ersteinrichtung: ${origin:-http://localhost:8090}/setup/"
    say "Einrichtungscode: $code"
}

cmd_uninstall() {
    purge=0
    for arg in "$@"; do
        [ "$arg" = "--purge" ] && purge=1
    done
    if [ "$purge" -eq 1 ]; then
        confirm "Container UND alle Daten (Datenbank, Backups im Volume, Zertifikate) werden gelöscht.
Kopien unter $WACHBUCH_DIR/backups und die .env bleiben." "ALLES LOESCHEN" || die "Abgebrochen."
        dc --profile ops --profile https down --volumes --remove-orphans
        say "Container und Volumes entfernt."
    else
        confirm "Die Wachbuch-Container werden entfernt. Daten (Volumes) bleiben erhalten." "ENTFERNEN" \
            || die "Abgebrochen."
        dc --profile ops --profile https down --remove-orphans
        say "Container entfernt; Daten bleiben in den Docker-Volumes (wachbuch start stellt alles wieder her)."
    fi
    say "Der Ordner $WACHBUCH_DIR (mit .env) bleibt bestehen; bei Bedarf von Hand löschen."
}

# Globale Option --yes an beliebiger Stelle
args=""
for arg in "$@"; do
    case "$arg" in
        -y|--yes) ASSUME_YES=1 ;;
        *) args="$args $(printf '%s' "$arg" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/")" ;;
    esac
done
eval "set -- $args"

command="${1:-help}"
[ $# -eq 0 ] || shift
case "$command" in
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    backup) cmd_backup ;;
    restore) cmd_restore "$@" ;;
    update) cmd_update "$@" ;;
    auto-update) cmd_auto_update "$@" ;;
    setup-code) cmd_setup_code ;;
    start) dc up -d --remove-orphans --wait --wait-timeout 600 && cmd_status ;;
    stop) dc stop ;;
    uninstall) cmd_uninstall "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "Unbekannter Befehl: $command" ;;
esac
