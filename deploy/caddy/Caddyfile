# TLS-Proxy für das Wachbuch (Compose-Profil "https", Dienst caddy).
#
# Werte aus .env (install.sh setzt sie je nach Betriebsart):
#   WACHBUCH_HOSTNAME  Name oder IP-Adresse, unter der die Wache das Wachbuch
#                      aufruft, z. B. wache.example.org oder 192.168.1.20
#   CADDY_TLS          "internal"  -> eigene Caddy-CA (LAN ohne Internet);
#                                     Geräte zeigen eine Zertifikatswarnung,
#                                     bis die CA importiert ist
#                      E-Mail      -> Zertifikat von Let's Encrypt (Domain,
#                                     Ports 80/443 aus dem Internet erreichbar)
#
# Caddy leitet HTTP auf HTTPS um und setzt X-Forwarded-Proto/-For selbst;
# vom Client gesendete X-Forwarded-*-Header werden verworfen. Deshalb darf
# web mit TRUSTED_PROXY=true laufen (web selbst lauscht nur auf Loopback).

{
	admin off
	# Die interne CA nicht in den (read-only) Container-Truststore eintragen;
	# Geräte importieren /data/caddy/pki/authorities/local/root.crt selbst.
	skip_install_trust
	servers {
		# Langsame Clients (Slowloris) nicht ewig offen halten.
		timeouts {
			read_header 10s
			read_body 2m
			idle 2m
		}
		# Compose veröffentlicht nur TCP 443; ohne HTTP/3 wirbt Caddy nicht
		# mit einem UDP-Port, der von außen nicht erreichbar ist.
		protocols h1 h2
	}
}

{$WACHBUCH_HOSTNAME} {
	tls {$CADDY_TLS}
	encode zstd gzip
	# Größer als jede erlaubte Anfrage (Anhänge max. 5 MiB, Formulare 10 MiB).
	request_body {
		max_size 20MB
	}
	header -Server
	reverse_proxy web:8000
}
