# TLS-Proxy für den Raspberry-Pi-Betrieb (deploy/pi/docker-compose.pi.yml).
# ${PI_SERVER_NAMES} setzt das nginx-Image beim Start ein.

upstream wachbuch_web {
    server web:8000;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name ${PI_SERVER_NAMES};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${PI_SERVER_NAMES};

    ssl_certificate /etc/nginx/tls/wachbuch.crt;
    ssl_certificate_key /etc/nginx/tls/wachbuch.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:5m;
    ssl_session_tickets off;

    client_max_body_size 6M;
    server_tokens off;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_read_timeout 70s;

    # Pfade mit Einmal- oder Gerätegeheimnissen nicht protokollieren.
    location ^~ /aktivieren/ {
        access_log off;
        proxy_pass http://wachbuch_web;
    }
    location ^~ /terminal/start/ {
        access_log off;
        proxy_pass http://wachbuch_web;
    }
    location ^~ /display/start/ {
        access_log off;
        proxy_pass http://wachbuch_web;
    }

    location / {
        proxy_pass http://wachbuch_web;
    }
}
