# Pflicht: unabhaengige Zufallswerte, z. B. openssl rand -hex 32
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
POSTGRES_DB=rwsth
POSTGRES_USER=rwsth_owner
POSTGRES_PASSWORD=replace-with-a-random-owner-password
APP_DB_USER=rwsth_app
APP_DB_PASSWORD=replace-with-a-random-app-password
FEED_DB_USER=rwsth_feed
FEED_DB_PASSWORD=replace-with-a-random-feed-password
BACKUP_DB_USER=rwsth_backup
BACKUP_DB_PASSWORD=replace-with-a-random-backup-password
PUSH_DB_USER=rwsth_push
PUSH_DB_PASSWORD=replace-with-a-random-push-password
FEED_WORKER_SECRET_KEY=replace-with-an-independent-random-value
PUSH_WORKER_SECRET_KEY=replace-with-an-independent-random-value-push

# Krypto-Master-Key fuer die AES-256-GCM-Verschluesselung der TOTP-Secrets.
# Unabhaengig von DJANGO_SECRET_KEY und damit separat rotierbar.
# Erzeugen mit: openssl rand -hex 32
# Wenn nicht gesetzt, wird HKDF(DJANGO_SECRET_KEY) verwendet (Rueckwaertskompatibilitaet).
# CRYPTO_MASTER_KEY=  # 64 Hex-Zeichen
# Waehrend einer Rotation zustzlich der alte Key (Fallback zum Entschluesseln):
# CRYPTO_PREVIOUS_MASTER_KEY=

# Salt fuer die Schluessel der Rate-Limit-Zaehler (Zufallswert empfohlen).
RATELIMIT_KEY_SALT=replace-with-an-independent-random-value-salt

# Gunicorn im web-Container (Standard 2 Prozesse x 4 Threads, 60 s Timeout).
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60

# Angezeigte Version ueberschreiben (Standard: core/version.py im Image).
# APP_VERSION=

# Lokaler HTTP-Schnellstart auf Loopback. Fuer TLS hinter Reverse-Proxy:
# SECURE_COOKIES=true und echte Hostnamen in ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8090
DJANGO_DEBUG=false
SECURE_COOKIES=false
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8090

# Erstinstallation: eigenen Zufallswert erzeugen (openssl rand -hex 32),
# nur über einen vertrauenswürdigen Zugang eingeben und nach Abschluss entfernen.
# Leer = kein Bootstrap-Zugang; niemals einen Beispielwert als Zugang verwenden.
SETUP_BOOTSTRAP_TOKEN=

# Wiederholbarer QR-Login ist opt-in und benötigt HTTPS.
# Beispiel einer kanonischen Adresse: https://wache.example (ohne Pfad).
# ALLOWED_HOSTS und CSRF_TRUSTED_ORIGINS müssen ebenfalls dazu passen.
QR_LOGIN_ENABLED=false
QR_LOGIN_TTL_SECONDS=120
SITE_URL=
# Nur hinter einem kontrollierten Proxy aktivieren, der Client-Forwarded-Header
# entfernt/überschreibt und den Backend-Port vor direktem Zugriff schützt.
# Das bloße Setzen von SITE_URL ist kein Nachweis für sicheren Transport.
TRUSTED_PROXY=false

# Wachenterminal: Touch-Bildschirm mit persönlicher PIN (docs/PI-WACHENTERMINAL.md).
TERMINAL_ENABLED=false
TERMINAL_IDLE_SECONDS=120
# SHA-256 des lokalen TLS-Zertifikats (64 Hex-Zeichen), nur bei eigenem
# Zertifikat ohne öffentliche Zertifizierungsstelle (z. B. Raspberry Pi-WLAN).
LOCAL_TLS_CERT_SHA256=
# WLAN der Wache für den WLAN-QR-Code im Sperrbildschirm (setup-pi.sh setzt beides).
TERMINAL_WIFI_SSID=
TERMINAL_WIFI_PASSWORD=

# Redis Cache (standardmaessig aktiv; leer setzen fuer reinen DB-Betrieb)
REDIS_URL=redis://redis:6379/0

DEFAULT_STATION_NAME=Rettungswache
DEFAULT_STATION_SLUG=rettungswache
APP_NAME=Wachwerk
SOURCE_URL=https://github.com/Katschko-IT/Rettungswache-Wachbuch

# Demo-Modus: Musterkonten + Beispieldaten (nur lokal/Vorfuhrung, nie produktiv)
DEMO_MODE=false
DEMO_PASSWORD=Demo-Passwort-12345

# Kommagetrennte HTTPS-Hosts fuer Feeds und den optionalen Muellkalender
FEED_ALLOWED_HOSTS=

# Aufbewahrung: Feed-Eintraege ohne Last-Seen; Audit nur nach Freigabe (0=aus)
RETENTION_FEED_DAYS=90
RETENTION_AUDIT_DAYS=0

# TOTP-Zweitfaktor (Authenticator-App); MFA_REQUIRED erzwingt Einrichtung nach Login
MFA_ENABLED=true
MFA_REQUIRED=false

# Oeffentliche Selbstregistrierung optional; Standard: Master-Admin legt Nutzer an
REGISTRATION_ENABLED=false
REGISTRATION_RATE_LIMIT=5

# Passkeys (WebAuthn) - RP_ID ohne Schema, ORIGIN mit https://
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Web-Push fuer dringende Uebergaben (VAPID-Schluessel noetig)
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=ops@example.org
# Optional: Push-Relay für native iOS-/Android-Benachrichtigungen (docs/PUSH-RELAY.md).
# Leer lassen, solange kein Relay betrieben wird; die App erinnert dann lokal.
PUSH_RELAY_URL=
PUSH_RELAY_TOKEN=

# Optional: E-Mail über SMTP (Kaffeekassen-Erinnerung mit Überweisungs-QR).
# Leer = keine E-Mails. Port 587 mit STARTTLS (Standard) oder 465 mit SSL.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional: Benachrichtigungen per Signal (docs/SIGNAL.md). Dazu
# COMPOSE_PROFILES um "signal" ergänzen, SIGNAL_API_URL=http://signal:8080 und
# die Nummer des Wachen-Handys (+49…) eintragen.
SIGNAL_API_URL=
SIGNAL_NUMBER=
# HTTPS-Host-Allowlist fuer Push-Subscription-Endpoints (SSRF-Schutz).
# Leer lassen fuer die eingebaute Liste bekannter Browser-Push-Dienste.
# Beispiel: fcm.googleapis.com,.push.apple.com
PUSH_ALLOWED_ENDPOINT_HOSTS=

BACKUP_UID=70
BACKUP_GID=70

# PostgreSQL-Speicher (optional). Standard ist bewusst klein für 1-2 GB RAM.
# Auf größeren Servern z. B. SHARED_BUFFERS=25 % und EFFECTIVE_CACHE_SIZE=50 %
# des RAM; MAX_CONNECTIONS mitziehen, wenn GUNICORN_WORKERS erhöht wird.
# POSTGRES_SHARED_BUFFERS=128MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
# POSTGRES_WORK_MEM=4MB
# POSTGRES_MAINTENANCE_WORK_MEM=64MB
# POSTGRES_MAX_CONNECTIONS=50
# POSTGRES_SHM_SIZE=256mb

# Offsite-Kopie (R-010). BACKUP_OFFSITE_DIR ist ein Ordner auf dem Host
# (z. B. NAS-Mount), der im backup-Container als /offsite erscheint; er muss
# UID/GID BACKUP_UID gehören (backup-init versucht chown). Dazu
# BACKUP_OFF_TARGET=file:///offsite setzen.
# Mit BACKUP_ENCRYPT_REMOTE=true wird jeder Dump vor der Kopie mit GnuPG gegen
# BACKUP_GPG_RECIPIENT (Fingerprint oder E-Mail) verschluesselt; ohne
# passenden Schluessel wird nie Klartext ausgelagert. Den oeffentlichen
# Schluessel (*.asc) in den Host-Ordner BACKUP_GPG_KEY_DIR legen.
BACKUP_OFFSITE_DIR=
BACKUP_GPG_KEY_DIR=
BACKUP_ENCRYPT_REMOTE=false
BACKUP_GPG_RECIPIENT=
BACKUP_OFF_TARGET=
# Abstand der Dumps und Wartezeit nach einem Fehler (Sekunden).
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETRY_SECONDS=3600

# Lokale Aufbewahrung alter Dumps im backup-Container in Tagen (Standard 7).
# 0 deaktiviert das Loeschen; der Ring waechst dann unbegrenzt.
BACKUP_RETENTION_DAYS=7

# Bereinigte 5xx-Fehlerereignisse (H4). Technische Aufbewahrungspolicy,
# ausdruecklich keine gesetzliche Frist. 0/leer fuehrt auf 30 Tage.
ERROR_EVENT_RETENTION_DAYS=30
# Obergrenze der Ereignisse im Supportbericht (Standard 200).
ERROR_EVENT_EXPORT_LIMIT=200

# Version und Herkunft der Images (install.sh setzt die Version).
# WACHBUCH_VERSION=0.25.0
# Eigene Registry, z. B. ein Spiegel im Wachen-Netz ohne Internet:
# WACHBUCH_REGISTRY=registry.wache.lan:5000/katschko-it

# Nächtliche Updates (wachbuch auto-update an|aus|status):
#   sicherheit = gleiche Version, wöchentlich neu gebaute Images
#   alle       = zusätzlich neue Versionen derselben Hauptversion
# WACHBUCH_AUTO_UPDATE=aus
# WACHBUCH_AUTO_UPDATE_TIME=03:30
